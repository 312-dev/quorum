{
  "manifest_version": 3,
  "name": "Quorum for Reddit: Community-Verified AI & Bot Filter",
  "short_name": "Quorum",
  "version": "0.4.0",
  "description": "Hides Reddit posts and comments that well-upvoted comments call out as AI or bots, behind Reddit's own blur and spoiler.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "*://www.reddit.com/*",
    "*://old.reddit.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.reddit.com/*",
        "*://old.reddit.com/*"
      ],
      "js": [
        "settings.js",
        "detect.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Quorum",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  }
}
